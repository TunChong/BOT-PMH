PORT=3000

# Thông tin LINE Messaging API. Không đưa giá trị thật vào Git hoặc chat.
LINE_CHANNEL_SECRET=thay-bang-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=thay-bang-channel-access-token

# Tài khoản hệ thống lấy PMH. Điền bằng biến môi trường trên máy chạy bot.
PMH_URL=https://script.google.com/macros/s/AKfycbxbtH1THZD7Ro-zJ5syICOy0ftscC6UzjCo449pnFqs8hfeiMCdCGltuRTClgVwDHNl/exec
PMH_USER=thay-bang-user
PMH_PASSWORD=thay-bang-mat-khau

# Mã ST điền vào ô “Nhập mã ST”. Đổi lại nếu mã cửa hàng thực tế khác.
PMH_STORE_CODE=112191

# Có thể bật log ít thông tin để kiểm tra lỗi; tuyệt đối không log mật khẩu/token.
LOG_LEVEL=info
